# ============================================================
# 生产环境变量模板
# 使用方法（在服务器上、仓库根目录）：
#   cp .env.example .env
#   编辑 .env 填入真实值
#   docker compose up -d --build
# 注意：.env 含密钥，不要提交到 git，也不要泄露
# ============================================================

# ---- 访问方式（暂无域名：用 公网IP+端口 直连）----
# 前台博客：http://<你的公网IP>:BLOG_PORT
# 后台管理：http://<你的公网IP>:ADMIN_PORT
# 云服务器安全组需放行这两个端口
BLOG_PORT=80
ADMIN_PORT=8081

# ---- MongoDB（容器内自建，不对外暴露端口）----
MONGO_ROOT_USER=app
# 必填，建议 20 位以上随机字符串（仅字母数字，避免特殊字符影响连接串解析）
MONGO_ROOT_PASSWORD=please_change_me_to_a_random_strong_password

# ---- 后端基础配置 ----
# JWT 签名密钥，必须换成新的随机长字符串（至少 32 位）
JWT_SECRET=please_change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=2h
# CORS 允许来源：暂无域名时填 http://<公网IP> 与 http://<公网IP>:8081，多个用英文逗号分隔
CLIENT_ORIGIN=http://127.0.0.1,http://127.0.0.1:8081
CAPTCHA_ENABLED=true
SMS_ENABLED=false
CONTENT_FILTER_ENABLED=true

# ---- 阿里云 OSS（可选，四项全填才启用，否则落本地 uploads/）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=

# ---- 阿里云百炼 DashScope（可选，缺失时 AI 相关接口返回 503）----
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
