VITE_BASE=/

# 接口地址（生产环境同域，由 nginx 反向代理到后端）
VITE_GLOB_API_URL=/api

# 博客前台地址（后台「博客前台」外链菜单跳转目标）
VITE_GLOB_BLOG_WEB_URL=http://123.57.41.200

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
