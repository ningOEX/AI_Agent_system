# ================================
# 后端服务环境变量模板
# ================================
# 使用方法：复制本文件为 .env，填入真实值（.env 已加入 .gitignore，不会被提交到仓库）
#   cp .env.example .env     # macOS/Linux
#   copy .env.example .env   # Windows PowerShell
#
# 必填项缺失 → 服务启动即报错
# 可选项缺失 → 功能自动降级/禁用，不影响启动
# ================================

# ---- 基础服务（必填）----
PORT=5000
# MongoDB 连接串。本地 mongod 默认无需用户名密码
MONGO_URI=mongodb://127.0.0.1:27017/login_demo
# JWT 签名密钥，任意长随机字符串即可（至少 16 位）
JWT_SECRET=change_me_to_a_random_long_string_at_least_16_chars
JWT_EXPIRES_IN=2h
# CORS 允许的前端来源，开发环境两个端口都要
CLIENT_ORIGIN=http://localhost:5666,http://localhost:3000
# 验证码开关：true 时登录/注册必须通过图形验证码校验才放行；false 仅建议本地临时调试
CAPTCHA_ENABLED=true
# 短信开关：false 为开发模式，短信验证码直接明文返回前端；true 表示接入真实短信服务商
SMS_ENABLED=false
# 敏感词校验开关：true（默认）时新建/编辑文章会做敏感词校验，命中直接拦截不落库；false 关闭校验
CONTENT_FILTER_ENABLED=true

# ---- 阿里云 OSS（可选）----
# 四个变量**全部填了**才真的启用 OSS 中转上传；留空则自动降级为本地 uploads/ 目录
# 需要在阿里云 RAM 创建 AccessKey，Bucket 需允许跨域 PUT
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=

# ---- 阿里云百炼 DashScope（可选）----
# 缺失时 AI 写作、智能客服 L3、文生图会返回 503，其他业务不受影响
DASHSCOPE_API_KEY=
# 客服默认模型，可选：qwen-plus / qwen-turbo / qwen-max
CHAT_MODEL=qwen-plus
